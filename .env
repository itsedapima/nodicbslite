# ══════════════════════════════════════════════════════════════════════════
#  NODi Lite — Environment Configuration
#  Copy to .env and fill in values for each chama instance.
# ══════════════════════════════════════════════════════════════════════════

# ── Instance Identity ────────────────────────────────────────────────────
CHAMA_NAME=repsi
CHAMA_DISPLAY_NAME="Repsi Self Help Group"

# ── Django Core ──────────────────────────────────────────────────────────
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=repsi.nodicbslite.peshapcloud.com,127.0.0.1,localhost,192.168.100.160
CSRF_TRUSTED_ORIGINS=https://repsi.nodicbslite.peshapcloud.com

# ── Database (each chama gets its own DB) ────────────────────────────────
DB_NAME=nodicbslite_db_v3
DB_USER=postgres
DB_PASSWORD=Bigman@2026
DB_HOST=127.0.0.1
DB_PORT=5432

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Admin Panel ──────────────────────────────────────────────────────────
ADMIN_URL_PATH=chama-admin
ADMIN_OTP_REQUIRED=True

# ── M-Pesa Daraja ────────────────────────────────────────────────────────
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_STK_CALLBACK_URL=
MPESA_B2C_SHORTCODE=
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_B2C_RESULT_URL=
MPESA_B2C_TIMEOUT_URL=

# ── SMS (Celcom Africa) ─────────────────────────────────────────────────
SMS_API_URL=https://isms.celcomafrica.com/api/services/sendsms/
SMS_API_KEY=
SMS_PARTNER_ID=
SMS_SHORTCODE=
SMS_SENDER_NAME=NODiLite

# ── Email ────────────────────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
ADMIN_EMAIL=

# ── CORS (for Android app) ──────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ── Approval Config ─────────────────────────────────────────────────────
# Default number of approvals required for fund disbursement
DEFAULT_APPROVAL_COUNT=2
ADMIN_SELF_APPROVE=False
