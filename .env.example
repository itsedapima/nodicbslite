# ══════════════════════════════════════════════════════════════════════════
#  NODi Lite — Environment Configuration (Production)
#  AUTO-GENERATED by onboard-chama.sh — or copy and fill in manually.
# ══════════════════════════════════════════════════════════════════════════

# ── Instance Identity ────────────────────────────────────────────────────
CHAMA_NAME=umoja
CHAMA_DISPLAY_NAME="Umoja Chama Group"

# ── Django Core ──────────────────────────────────────────────────────────
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

DJANGO_ALLOWED_HOSTS=umoja.peshapcloud.com
CSRF_TRUSTED_ORIGINS=https://umoja.peshapcloud.com

# ── Database (shared Postgres via PgBouncer) ────────────────────────────
DB_NAME=umoja_db
DB_USER=umoja_user
DB_PASSWORD=change-me

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me

# ── Gunicorn ─────────────────────────────────────────────────────────────
GUNICORN_WORKERS=2

# ── Admin Panel ──────────────────────────────────────────────────────────
ADMIN_URL_PATH=chama-admin
ADMIN_OTP_REQUIRED=True

# ── M-Pesa Daraja ────────────────────────────────────────────────────────
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_STK_CALLBACK_URL=https://umoja.peshapcloud.com/api/mpesa/callback/

# B2C (withdrawals / loan disbursement)
MPESA_B2C_SHORTCODE=
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_B2C_RESULT_URL=https://umoja.peshapcloud.com/api/mpesa/b2c/result/
MPESA_B2C_TIMEOUT_URL=https://umoja.peshapcloud.com/api/mpesa/b2c/timeout/

# ── SMS (Celcom Africa) ─────────────────────────────────────────────────
SMS_API_URL=https://isms.celcomafrica.com/api/services/sendsms/
SMS_API_KEY=
SMS_PARTNER_ID=
SMS_SHORTCODE=
SMS_SENDER_NAME=NODiLite

# ── Email ────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
ADMIN_EMAIL=
BACKUP_EMAIL_RECIPIENT=

# ── CORS (for Android app) ──────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://umoja.peshapcloud.com

# ── Approval Config ─────────────────────────────────────────────────────
DEFAULT_APPROVAL_COUNT=2
ADMIN_SELF_APPROVE=False
